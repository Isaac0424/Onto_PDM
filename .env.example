# 복사해서 .env 로 쓴다 (.env 는 git에 올라가지 않는다). 값은 비워 둔 채로 커밋한다.

# ---- Claude API (분류 에이전트, server/claude-endpoint.mjs) ----
ANTHROPIC_API_KEY=

# ---- LangSmith 클라우드 (APAC 리전) ----
# 조직을 https://apac.smith.langchain.com 에서 만든 경우. 엔드포인트 끝에 / 를 붙이지 않는다.
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://apac.api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=onto-pdm-classifier-dev
# 사양서 본문 · CAD 이름을 추적에 남기지 않으려면 둘 다 true (전부 숨김).
# 일부만 가리려면 false 로 두고 에이전트 코드에서 Client(hide_inputs=함수)로 본문만 구절 id로 바꾼다.
LANGSMITH_HIDE_INPUTS=false
LANGSMITH_HIDE_OUTPUTS=false

# ---- PostgreSQL (역할은 db/roles.sql) ----
# PDM API 서버
DATABASE_URL=postgres://pdm_app@localhost:5432/onto_pdm
# 분류 에이전트 (임시저장 · 제안만 쓸 수 있는 역할)
AGENT_DATABASE_URL=postgres://class_agent@localhost:5432/onto_pdm

# ---- GraphDB ----
GRAPHDB_URL=http://localhost:7200
GRAPHDB_REPOSITORY=onto-pdm
GRAPHDB_STAGING_REPOSITORY=onto-pdm-staging
