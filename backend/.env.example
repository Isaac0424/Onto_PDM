# PDM 백엔드가 OPMS 의 Neo4j 를 **읽기만** 하기 위한 접속 정보 (backend/README.md 의 "OPMS 읽기").
# 이 파일을 .env 로 복사해 채우거나, 백엔드를 켤 때 환경 변수로 넘긴다. .env 는 저장소에 올리지 않는다(.gitignore).
# 값은 OPMS 저장소(ernest_hemingway_OPMS)의 로컬 .env / docker-compose.yml 의 NEO4J_* 와 같다. 비밀번호를 여기에 적지 마라.
PDM_NEO4J_URI=bolt://127.0.0.1:7687
PDM_NEO4J_USER=neo4j
PDM_NEO4J_PASSWORD=<OPMS 의 NEO4J_PASSWORD>
# 선택: OPMS 가 데이터베이스 이름을 바꿔 쓸 때만
# PDM_NEO4J_DATABASE=neo4j
